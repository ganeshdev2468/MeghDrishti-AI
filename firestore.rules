rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Emergency alerts — authenticated responders can read/write
    match /emergency_alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['alertLevel', 'location', 'timestamp', 'createdBy']);
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Inundation scenarios
    match /inundation_scenarios/{scenarioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User responder profiles
    match /responder_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deployment logs
    match /deployment_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
